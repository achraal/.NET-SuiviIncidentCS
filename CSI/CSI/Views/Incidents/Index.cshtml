@model IEnumerable<CSI.Models.Incident>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Severite)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Etat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SourceDetection)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateDeclaration)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateResolution)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AnalysteEnCharge)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Type)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Severite)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Etat)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SourceDetection)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateDeclaration)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateResolution)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AnalysteEnCharge.Email)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
